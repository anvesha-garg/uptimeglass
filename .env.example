# Copy this file to .env and fill in real values. NEVER commit .env.
# Secret values must stay BLANK in this example file (a test checks this).

# --- App ---
ENV=development
FRONTEND_ORIGIN=http://localhost:5173
RUN_EMBEDDED_WORKER=true

# --- Database and Redis (these match docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://uptimeglass:uptimeglass@localhost:5433/uptimeglass
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Groq AI (optional: the app works without it) ---
# Get a free key at https://console.groq.com
# Check the current model names in the Groq docs before filling GROQ_MODEL.
GROQ_API_KEY=
GROQ_MODEL=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=

# --- Email alerts (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
